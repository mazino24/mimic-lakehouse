# Copy to .env and adjust. docker-compose reads this file automatically.

# ── Object storage (MinIO locally, S3 in the cloud) ──────────────────────────
LAKE_ROOT=s3a://mimic-lake
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true
S3_ENABLED=true

# ── Warehouse ────────────────────────────────────────────────────────────────
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=mimic
WAREHOUSE_USER=mimic
WAREHOUSE_PASSWORD=mimic
WAREHOUSE_LOAD_SCHEMA=lake

# ── Spark sizing ─────────────────────────────────────────────────────────────
# Two 4 GB workers handle the synthetic demo comfortably. For the real 41 GB
# extract, raise both and set SPARK_SHUFFLE_PARTITIONS to ~3x total cores.
SPARK_WORKERS=2
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=16
SPARK_LOG_LEVEL=WARN

LOG_LEVEL=INFO
